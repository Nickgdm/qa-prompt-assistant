# Escolha um provedor: gemini, openai_compatible ou ollama
AI_PROVIDER=gemini

# MODELO: use um nome de modelo habilitado na conta/provedor escolhido
AI_MODEL=gemini-3.5-flash-lite

# GEMINI: chave obtida no Google AI Studio. Também aceita GEMINI_API_KEY para compatibilidade antiga.
GEMINI_API_KEY=COLOQUE_SUA_CHAVE_AQUI

# OPENAI-COMPATIBLE: para OpenAI, OpenRouter, Groq, Together e outros serviços compatíveis.
# Defina a chave e URL base conforme a documentação do serviço.
# AI_PROVIDER=openai_compatible
# AI_API_KEY=SUA_CHAVE_AQUI
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini

# OLLAMA LOCAL: sem chave de API por padrão; instale/execute Ollama e baixe um modelo primeiro.
# AI_PROVIDER=ollama
# AI_MODEL=llama3.2
# AI_BASE_URL=http://localhost:11434/v1
